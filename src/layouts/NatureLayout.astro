---
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";
import { protectedAreas } from "@data/protected-areas";
import { sportsAdventures } from "@data/sports-adventures";

import ContainerText from "@components/ContainerText.astro";
import Datalist from "@components/Datalist.astro";
import Cards from "@components/Cards.astro";

const nature = await getCollection("nature");
---

<section class="bg-bg-primary px-8 py-24">
  <ContainerText
    title="Flora y Fauna"
    description="Nicaragua es considerada uno de los países más biodiversos del mundo, con especies endémicas y ecosistemas únicos que van desde bosques nubosos hasta arrecifes de coral."
  />

  <div class="mx-4 mt-12 mb-24 grid gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-4">
    {nature.map((nat) => {
      const { id, title, image, imageAlt } = nat.data;

      return (
        <a href={import.meta.env.BASE_URL + `nature/${id}`}>
          <article
            id={id}
            class="relative min-h-80 cursor-pointer overflow-hidden rounded-md transition hover:scale-105"
            transition:name={`img-${id}`}
          >
            <figure class="h-80 overflow-hidden">
              <Picture
                src={image}
                alt={imageAlt ?? title}
                width={400}
                formats={["avif", "webp"]}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </figure>

            <div class="absolute inset-0 bg-black/40 p-6 text-white">
              <h3 class="text-xl font-bold">{title}</h3>
            </div>
          </article>
        </a>
      );
    })}
  </div>

  <ContainerText
    title="Áreas Protegidas"
    description="Con 77 áreas protegidas que abarcan más del 20% del territorio nacional, Nicaragua cuenta con una impresionante red de parques nacionales, reservas biológicas, santuarios de flora y fauna y reservas naturales que protegen ecosistemas vitales y ofrecen experiencias inolvidables a los visitantes."
  />

  <div class="mb-24">
    {protectedAreas.map((area) => (
      <Datalist title={area.title} description={area.description} />
    ))}
  </div>

  <ContainerText
    title="Deportes y Aventuras"
    description="Las vastas reservas naturales, volcanes, ríos y costas de Nicaragua ofrecen condiciones únicas para los deportes de aventura, desde el senderismo y el volcánismo hasta el surf y el canopy"
  />

  <div class="mx-4 mt-12 grid gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-3">
    {sportsAdventures.map((sport) => (
      <Cards {...sport} />
    ))}
  </div>
</section>
