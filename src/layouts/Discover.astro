---
import ContainerText from "@components/ContainerText.astro";
import videoNic from "@assets/video/nicaragua-video.mp4";
---

<section id="discover" class="bg-bg-primary px-8 py-24 md:px-12">
  <ContainerText
    title="Descubre Nicaragua a través de un video."
    description="Déjate cautivar por la belleza de nuestros paisajes, la calidez de
      nuestra gente y la riqueza de nuestra cultura."
  />

  <div class="relative mx-auto w-full max-w-3xl overflow-hidden rounded-md">
    <video
      id="discover-video"
      class="block w-full"
      src={videoNic}
      controls
      muted
      autoplay
      loop
      preload="metadata"
      playsinline
      aria-label="video promocional de Nicaragua"
    >
      Tu navegador no admite el elemento de video.
    </video>
  </div>
</section>

<script>
  const handlePageLoad = () => {
    const video = document.getElementById(
      "discover-video",
    ) as HTMLVideoElement | null;
    if (video) {
      video.muted = true;
      video.play().catch(() => {});
    }
  };

  const handleBeforeSwap = () => {
    const video = document.getElementById(
      "discover-video",
    ) as HTMLVideoElement | null;
    if (video) {
      video.pause();
      video.muted = true;
    }
  };

  document.addEventListener("astro:page-load", handlePageLoad);
  document.addEventListener("astro:before-swap", handleBeforeSwap);
</script>
