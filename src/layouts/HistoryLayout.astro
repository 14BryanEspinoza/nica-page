---
import ContainerText from "@components/ContainerText.astro";
import Timeline from "@components/Timeline.astro";
import Datalist from "@components/Datalist.astro";

import { curiosities } from "@data/curiosities";
---

<section class="bg-bg-primary px-8 py-24">
  <ContainerText
    title="Línea del Tiempo"
    description="Desde los pueblos indígenas que habitaban esta tierra hasta los eventos que moldearon al Nicaragua de hoy."
  />

  <Timeline />

  <ContainerText
    title="Festividades y Celebraciones"
    description="Fiestas patronales, celebraciones religiosas y eventos culturales que llenan de alegría las calles de Nicaragua durante todo el año."
  />

  {curiosities.map((curio) => (
    <Datalist title={curio.title} description={curio.description} />
  ))}
</section>
