---
interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  backUrl?: string;
}

import { ClientRouter } from "astro:transitions";
import { meta } from "@metadata/metadata";
import Link from "@components/Link.astro";
import "../styles/global.css";

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;

const {
  title,
  description,
  keywords,
  backUrl = import.meta.env.BASE_URL,
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <meta name="description" content={description || meta.description} />
    <meta name="keywords" content={keywords || meta.keywords} />
    <meta name="author" content={meta.author} />
    <meta name="robots" content="index, follow" />

    <meta property="og:title" content={title || meta.title} />
    <meta property="og:description" content={description || meta.description} />
    <meta property="og:image" content={meta.image} />
    <meta property="og:image:alt" content={meta.imageAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_NI" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title || meta.title} />
    <meta
      name="twitter:description"
      content={description || meta.description}
    />
    <meta name="twitter:image" content={meta.image} />
    <meta name="twitter:image:alt" content={meta.imageAlt} />

    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      type="image/png"
      href={import.meta.env.BASE_URL + "favicon.png"}
    />

    <title>{title || meta.title}</title>

    <ClientRouter />
  </head>
  <body>
    <header class="sticky top-0 z-10 flex flex-wrap items-center justify-between bg-bg-primary px-6 py-3 shadow-md lg:flex-nowrap lg:px-12">
      <a
        class="flex items-center gap-2 transition hover:scale-105"
        href={import.meta.env.BASE_URL}
      >
        <figure class="size-7">
          <img
            src={import.meta.env.BASE_URL + "favicon.png"}
            alt="ir al inicio"
            loading="lazy"
          />
        </figure>
        <span class="text-lg font-bold text-text-blue">NicaPage</span>
      </a>

      <Link url={backUrl} label="Volver" icon="lucide:arrow-left" />
    </header>

    <slot />
  </body>
</html>
