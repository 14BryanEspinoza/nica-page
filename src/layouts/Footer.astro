---
import { linkNavbar, linkOthers, socialNetworks } from "@data/links";
import Link from "@components/Link.astro";
---

<footer class="bg-linear-to-r from-text-blue to-text-blue-light px-8 py-16 text-bg-primary">
  <h2 class="mb-4 text-2xl font-bold uppercase">NicaPage</h2>

  <p>
    Tu guía completa para descubrir la belleza, la historia y la cultura de
    Nicaragua. La tierra de los lagos y los volcanes.
  </p>

  <section class="my-12 grid gap-12 md:grid-cols-2">
    <article>
      <h3 class="mb-4 font-bold">Redes sociales</h3>

      <nav aria-label="redes sociales">
        <ul class="flex gap-8">
          {socialNetworks.map((link) => (
            <li>
              <Link
                {...link}
                className="rounded-full border border-text-muted p-3 hover:border-border hover:text-bg-primary"
              />
            </li>
          ))}
        </ul>
      </nav>
    </article>

    <article>
      <h3 class="mb-4 font-bold">Navegación</h3>

      <nav aria-label="enlaces del pie de página">
        <ul class="flex flex-col items-start gap-8 lg:flex-row">
          {linkNavbar.map((link) => (
            <li>
              <Link
                url={link.url}
                label={link.label}
                className="hover:underline"
              />
            </li>
          ))}
        </ul>
      </nav>
    </article>
  </section>

  <article class="flex flex-col items-center gap-8 border-t border-border pt-12 md:flex-row md:justify-between">
    <nav aria-label="enlaces legales">
      <ul class="flex gap-12" role="list">
        {linkOthers.map((link) => (
          <li>
            <Link
              url={link.url}
              label={link.label}
              className="text-sm hover:underline"
            />
          </li>
        ))}
      </ul>
    </nav>

    <small>&copy; 14BryanEspinoza - 2026</small>
  </article>
</footer>
