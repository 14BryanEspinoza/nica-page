---
import Link from "@components/Link.astro";
import { linkNavbar, linkOthers, socialNetworks } from "@data/links";
---

<footer class="bg-text-blue px-8 py-16 text-bg-primary" aria-label="footer">
  <h2 class="mb-4 text-2xl font-bold uppercase">NicaPage</h2>

  <p>
    Your complete guide to discovering the beauty, history, and culture of
    Nicaragua. The land of lakes and volcanoes.
  </p>

  <section class="my-12 grid grid-cols-1 gap-12 md:grid-cols-2">
    <article>
      <h3 class="mb-4 font-bold">Social Networks</h3>

      <nav aria-label="social links">
        <ul class="flex gap-8">
          {socialNetworks.map((link) => (
            <li>
              <Link
                {...link}
                viewIcon
                className="rounded-full border border-text-muted p-3 hover:border-bg-tertiary hover:text-bg-tertiary"
              />
            </li>
          ))}
        </ul>
      </nav>
    </article>

    <article>
      <h3 class="mb-4 font-bold">Navigation</h3>

      <nav aria-label="footer links">
        <ul class="flex flex-col items-start gap-8 lg:flex-row">
          {linkNavbar.map((link) => (
            <li>
              <Link
                {...link}
                className="hover:border-bg-tertiary hover:text-bg-tertiary hover:underline"
              />
            </li>
          ))}
        </ul>
      </nav>
    </article>
  </section>

  <article class="flex flex-col items-center gap-8 border-t border-border pt-12 md:flex-row md:justify-between">
    <nav aria-label="legal links">
      <ul class="flex gap-12" role="list">
        {linkOthers.map((link) => (
          <li>
            <Link
              url={link.url}
              label={link.label}
              className="text-sm hover:border-bg-tertiary hover:text-bg-tertiary hover:underline"
            />
          </li>
        ))}
      </ul>
    </nav>

    <small class="opacity-90">&copy; 14BryanEspinoza - 2026</small>
  </article>
</footer>
