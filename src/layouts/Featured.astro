---
import type { CollectionEntry } from "astro:content";

interface Props {
  title: string;
  description: string;
  collection:
    CollectionEntry<"destination">[] | CollectionEntry<"gastronomy">[];
  link: string;
  label: string;
}

const { title, description, collection, link, label } = Astro.props;

import Cards from "@components/Cards.astro";
import ContainerText from "@components/ContainerText.astro";
import Link from "@components/Link.astro";
---

<section class="bg-bg-secondary px-8 py-24 md:px-12">
  <ContainerText title={title} description={description} />

  <div class="mx-4 mt-12 grid gap-4 md:grid-cols-2 md:gap-4 lg:grid-cols-3">
    {collection.map((coll) => {
      const { title, image, imageAlt, description } = coll.data;

      return (
        <Cards
          title={title}
          description={description}
          image={image}
          imageAlt={imageAlt}
        />
      );
    })}
  </div>

  <div class="mt-12 flex justify-center">
    <Link
      url={link}
      label={`Explora ${label} ->`}
      className="rounded-md bg-text-blue-light p-4 px-6 font-bold text-bg-primary hover:bg-success"
    />
  </div>
</section>
