---
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";

import ContainerText from "@components/ContainerText.astro";

const gastronomy = await getCollection("gastronomy");
---

<section id="meals" class="bg-bg-primary px-8 py-24">
  <ContainerText
    title="Platos Tradicionales"
    description="La cocina nicaragüense es una mezcla de tradiciones indígenas, influencias españolas y toques del Caribe que crean sabores únicos."
  />

  <div class="mx-4 mt-12 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-4">
    {gastronomy.map((gast) => {
      const { id, title, image, imageAlt } = gast.data;

      return (
        <a href={import.meta.env.BASE_URL + `gastronomy/${id}`}>
          <article
            id={id}
            class="relative min-h-80 cursor-pointer overflow-hidden rounded-md transition hover:scale-105"
            transition:name={`img-${id}`}
          >
            <figure class="h-80 overflow-hidden">
              <Picture
                src={image}
                alt={imageAlt ?? title}
                width={400}
                formats={["avif", "webp"]}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </figure>

            <div class="absolute inset-0 bg-black/40 p-6 text-white">
              <h3 class="text-xl font-bold">{title}</h3>
            </div>
          </article>
        </a>
      );
    })}
  </div>
</section>
