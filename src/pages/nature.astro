---
import Layout from "@layouts/Layout.astro";
import HeroSecondary from "@layouts/HeroSecondary.astro";
import NatureLayout from "@layouts/NatureLayout.astro";
import CallToAction from "@layouts/CallToAction.astro";
import Footer from "@layouts/Footer.astro";
---

<Layout
  title="NicaPage - Naturaleza"
  description="Explora la flora y fauna de Nicaragua, sus 71 áreas protegidas como Indio Maíz y Ometepe, y los deportes de aventura: surf, senderismo, canyoning y buceo."
  keywords="naturaleza Nicaragua, flora y fauna, áreas protegidas, biodiversidad, deportes de aventura, volcanes, surf"
>
  <main id="main-content">
    <HeroSecondary
      title="Naturaleza y aventura"
      description="Descubre una biodiversidad única y vive aventuras extremas en Nicaragua."
    />
    <NatureLayout />
    <CallToAction
      title="¿Listo para la aventura?"
      description="Planifica tu viaje a Nicaragua y disfruta de experiencias únicas en medio de la naturaleza más salvaje de Centroamérica."
      buttonText="Explorar historia"
      buttonLink={import.meta.env.BASE_URL + "history"}
      buttonText2="Explorar"
      buttonLink2={import.meta.env.BASE_URL}
    />
  </main>
  <Footer />
</Layout>
