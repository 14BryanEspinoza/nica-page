---
import Layout from "@layouts/Layout.astro";
import HeroSecondary from "@layouts/HeroSecondary.astro";
import CallToAction from "@layouts/CallToAction.astro";
import Footer from "@layouts/Footer.astro";
---

<Layout title="Nica-Page">
  <main id="main-content">
    <HeroSecondary
      id="naturePage"
      title="Nature and Adventure"
      description="Discover unique biodiversity and experience extreme adventures in Nicaragua."
    />
    <CallToAction
      title="Ready for adventure?"
      description="Plan your trip to Nicaragua and enjoy unique experiences amidst Central America's wildest nature."
      buttonText="Explore history"
      buttonLink="/nica-page/history"
      buttonText2="Explore"
      buttonLink2="/nica-page/"
    />
  </main>
  <Footer />
</Layout>
