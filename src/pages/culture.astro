---
import Layout from "@layouts/Layout.astro";
import HeroSecondary from "@layouts/HeroSecondary.astro";
import CallToAction from "@layouts/CallToAction.astro";
import Footer from "@layouts/Footer.astro";
---

<Layout title="NicaPage | Cultura">
  <main id="main-content">
    <HeroSecondary
      id="culturePage"
      title="Cultura y fiestas"
      description="Tradiciones, celebraciones y expresiones artísticas que definen el alma nicaragüense"
    />
    <CallToAction
      title="¿Quieres vivir estas experiencias?"
      description="Explora los destinos turísticos donde puedes presenciar estas tradiciones y descubre la belleza natural de Nicaragua."
      buttonText="Explorar turismo"
      buttonLink="/nica-page/tourism"
      buttonText2="Explorar gastronomía"
      buttonLink2="/nica-page/gastronomy"
    />
  </main>
  <Footer />
</Layout>
