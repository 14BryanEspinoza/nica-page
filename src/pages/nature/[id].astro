---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { Picture } from "astro:assets";

import LayoutPage from "@layouts/LayoutPage.astro";
import Tag from "@components/Tag.astro";
import Footer from "@layouts/Footer.astro";

export const getStaticPaths = async () => {
  const nature = await getCollection("nature");

  return nature.map((nat) => ({
    params: { id: nat.data.id },
    props: { nat },
  }));
};

const { nat } = Astro.props;
const { data } = nat;
const {
  id,
  title,
  description,
  image,
  imageAlt,
  scientificName,
  category,
  habitat,
  tag,
  conservationStatus,
} = data;
---

<LayoutPage
  title={`NicaPage - ${title}`}
  description={description}
  keywords={`${title}, ${category}, ${tag}, ${
    category === "Fauna" ? "fauna" : "flora"
  } de Nicaragua, biodiversidad de Nicaragua, especies de Nicaragua`}
  backUrl={import.meta.env.BASE_URL + "nature#nature"}
>
  <main id="main-content" class="mx-auto max-w-6xl px-6 py-12 lg:px-12">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-start">
      <section class="lg:col-span-6">
        <header class="mb-4 text-center lg:text-left">
          <h1 class="text-2xl font-extrabold text-text-blue">{title}</h1>

          <p class="mt-2 text-lg text-text-secondary italic">
            {scientificName}
          </p>

          <div class="mt-4 flex flex-wrap items-center justify-center gap-2 lg:justify-start">
            <Tag
              label={category}
              icon="layers"
              className="border-border bg-bg-tertiary text-text-blue-light transition hover:border-primary"
            />

            <Tag
              label={tag}
              icon="tag"
              className="border-border bg-bg-tertiary text-success transition hover:border-primary"
            />

            <Tag
              label={conservationStatus}
              icon="shield-check"
              className="border-border bg-bg-tertiary text-accent transition hover:border-primary"
            />
          </div>
        </header>

        <div class="relative overflow-hidden rounded-xl border border-border bg-bg-secondary">
          <Picture
            src={image}
            alt={imageAlt}
            class="h-90 w-full object-cover transition hover:scale-105"
            transition:name={`img-${id}`}
          />
        </div>
      </section>

      <section class="flex flex-col gap-2 lg:col-span-6">
        <article class="rounded-xl border border-border bg-bg-primary p-6 shadow-xs">
          <h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-text-blue">
            <Icon name="lucide:book-open" class="size-5" />
            Descripción
          </h2>

          <p class="text-justify text-sm leading-relaxed text-text-primary">
            {description}
          </p>
        </article>

        <div class="grid gap-2 sm:grid-cols-2">
          <div class="flex flex-col gap-1 rounded-lg border border-border bg-bg-secondary p-4 transition-colors hover:border-text-blue-light/40 hover:bg-bg-tertiary">
            <div class="flex items-center gap-2 text-xs font-semibold tracking-wider text-text-muted">
              <Icon name="lucide:dna" class="size-4 text-text-blue-light" />
              Nombre Científico
            </div>
            <span class="text-sm font-semibold text-text-primary italic">
              {scientificName}
            </span>
          </div>

          <div class="flex flex-col gap-1 rounded-lg border border-border bg-bg-secondary p-4 transition-colors hover:border-text-blue-light/40 hover:bg-bg-tertiary">
            <div class="flex items-center gap-2 text-xs font-semibold tracking-wider text-text-muted">
              <Icon name="lucide:trees" class="text-text-accent size-4" />
              Categoría
            </div>
            <span class="text-sm font-semibold text-text-primary">
              {category}
            </span>
          </div>

          <div class="flex flex-col gap-1 rounded-lg border border-border bg-bg-secondary p-4 transition-colors hover:border-text-blue-light/40 hover:bg-bg-tertiary">
            <div class="flex items-center gap-2 text-xs font-semibold tracking-wider text-text-muted">
              <Icon name="lucide:tag" class="size-4 text-text-blue" />
              Clasificación
            </div>
            <span class="text-sm font-semibold text-text-primary">{tag}</span>
          </div>

          <div class="flex flex-col gap-1 rounded-lg border border-border bg-bg-secondary p-4 transition-colors hover:border-text-blue-light/40 hover:bg-bg-tertiary">
            <div class="flex items-center gap-2 text-xs font-semibold tracking-wider text-text-muted">
              <Icon
                name="lucide:shield-check"
                class="text-text-success size-4"
              />
              Estado de Conservación
            </div>
            <span class="text-sm font-semibold text-text-primary">
              {conservationStatus}
            </span>
          </div>

          <div class="flex flex-col gap-1 rounded-lg border border-border bg-bg-secondary p-4 transition-colors hover:border-text-blue-light/40 hover:bg-bg-tertiary sm:col-span-2">
            <div class="flex items-center gap-2 text-xs font-semibold tracking-wider text-text-muted">
              <Icon name="lucide:map-pin" class="text-text-accent size-4" />
              Hábitat Natural
            </div>
            <span class="text-sm font-medium text-text-primary">{habitat}</span>
          </div>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</LayoutPage>
