---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import LayoutPage from "@layouts/LayoutPage.astro";
import ItemList from "@components/ItemList.astro";
import Tag from "@components/Tag.astro";

export const getStaticPaths = async () => {
  const gastronomy = await getCollection("gastronomy");

  return gastronomy.map((gast) => ({
    params: { id: gast.data.id },
    props: { gast },
  }));
};

const sectionStyle =
  "rounded-2xl border border-border bg-bg-primary p-5 shadow";
const backMealsUrl = import.meta.env.BASE_URL + "gastronomy/#meals";

const { gast } = Astro.props;
const { data } = gast;
const { id, title, description, image, imageAlt, ingredients, tag } = data;
---

<LayoutPage title={`NicaPage - ${title}`} backUrl={backMealsUrl}>
  <main
    id="main-content"
    class="mx-auto min-h-[calc(100vh-65px)] max-w-6xl px-4 py-8 sm:px-6 sm:py-10 md:py-12 lg:px-8"
  >
    <article class="grid gap-8 lg:grid-cols-12 lg:items-start lg:gap-10">
      <section class="flex flex-col gap-5 lg:col-span-5">
        <Image
          src={image}
          alt={imageAlt}
          class="h-72 w-full rounded-md object-cover md:h-96 lg:h-100"
          transition:name={`img-${id}`}
          loading="eager"
        />
      </section>

      <section class="flex flex-col gap-4 lg:col-span-7">
        <header class="flex flex-col gap-4">
          <div class="flex flex-wrap items-center gap-4">
            <Tag
              label={tag}
              icon="utensils"
              className="border-accent bg-accent-subtle text-accent"
            />

            <Tag
              label="Sabor Tradicional"
              icon="sparkles"
              className="border-border bg-bg-tertiary text-text-blue-light"
            />
          </div>

          <h1 class="text-3xl font-extrabold text-primary">{title}</h1>
        </header>

        <section class={sectionStyle}>
          <h2 class="mb-3 flex items-center gap-2 text-lg font-bold text-primary">
            <Icon name="lucide:book-open" class="size-5" />
            Sobre este plato tradicional
          </h2>

          <p class="text-text-secondary">{description}</p>
        </section>

        <section class={sectionStyle}>
          <h2 class="flex items-center gap-2 border-b border-border pb-3 font-bold text-text-blue-light">
            <Icon name="lucide:cooking-pot" class="size-5" />
            Ingredientes Principales
          </h2>

          <p class="my-4 text-sm text-text-muted">
            Los elementos esenciales que dan vida a su textura y sabor
            característico:
          </p>

          <ul class="grid grid-cols-1 gap-2 md:grid-cols-2">
            {ingredients.map((item) => (
              <ItemList item={item} />
            ))}
          </ul>
        </section>
      </section>
    </article>
  </main>
</LayoutPage>
