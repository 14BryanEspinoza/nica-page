---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

import LayoutMeals from "@layouts/LayoutMeals.astro";

export const getStaticPaths = async () => {
  const gastronomy = await getCollection("gastronomy");

  return gastronomy.map((gast) => ({
    params: { id: gast.data.id },
    props: { gast },
  }));
};

const { gast } = Astro.props;
const { data } = gast;
const { id, title, description, image, imageAlt, ingredients, tag } = data;
---

<LayoutMeals title=`NicaPage | ${title}`>
  <main id="main-content" class="flex items-end gap-8 px-24 py-12">
    <section>
      <h1 class="text-4xl font-extrabold text-text-blue">{title}</h1>

      <span class="text-md mt-2 tracking-wider text-text-accent uppercase">
        {tag}
      </span>

      <div class="mt-2 overflow-hidden rounded-md shadow-lg">
        <Image
          src={image}
          alt={imageAlt}
          class="h-96 w-full object-cover"
          transition:name={`img-${id}`}
        />
      </div>
    </section>

    <section class="max-w-3xl">
      <p class="mb-6 text-justify text-lg leading-relaxed text-text-primary">
        {description}
      </p>

      <div class="rounded-lg border border-border bg-text-blue-light p-6">
        <h2 class="mb-4 text-xl font-bold text-white">
          Ingredientes Principales
        </h2>

        <ul class="grid list-inside list-disc grid-cols-1 gap-2 text-white md:grid-cols-2">
          {ingredients.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</LayoutMeals>
