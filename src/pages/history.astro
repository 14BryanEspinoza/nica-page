---
import Layout from "@layouts/Layout.astro";
import HeroSecondary from "@layouts/HeroSecondary.astro";
import HistoryLayout from "@layouts/HistoryLayout.astro";
import CallToAction from "@layouts/CallToAction.astro";
import Footer from "@layouts/Footer.astro";
---

<Layout
  title="NicaPage - Historia"
  description="Recorre la historia de Nicaragua en una línea del tiempo: de la época precolombina y la colonización a la revolución sandinista, con datos que no sabías."
  keywords="historia de Nicaragua, línea del tiempo, independencia, sandinismo, Sandino, colonización, curiosidades"
>
  <main id="main-content">
    <HeroSecondary
      title="Historia de Nicaragua"
      description="Un recorrido por los momentos que definieron nuestra nación, además de datos fascinantes."
    />
    <HistoryLayout />
    <CallToAction
      title="¿Quieres saber más?"
      description="Descubre la cultura, las fiestas y las aventuras que te esperan en Nicaragua."
      buttonText="Explorar naturaleza"
      buttonLink={import.meta.env.BASE_URL + "nature"}
      buttonText2="Explorar cultura"
      buttonLink2={import.meta.env.BASE_URL + "culture"}
    />
  </main>
  <Footer />
</Layout>
