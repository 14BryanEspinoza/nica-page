---
import Layout from "@layouts/Layout.astro";
import HeroSecondary from "@layouts/HeroSecondary.astro";
import HistoryLayout from "@layouts/HistoryLayout.astro";
import CallToAction from "@layouts/CallToAction.astro";
import Footer from "@layouts/Footer.astro";
---

<Layout title="NicaPage | Historia">
  <main id="main-content">
    <HeroSecondary
      id="historyPage"
      title="Historia de Nicaragua"
      description="Un recorrido por los momentos que definieron nuestra nación, además de datos fascinantes."
    />
    <HistoryLayout />
    <CallToAction
      title="¿Quieres saber más?"
      description="Descubre la cultura, las fiestas y las aventuras que te esperan en Nicaragua."
      buttonText="Explorar naturaleza"
      buttonLink="/nica-page/nature"
      buttonText2="Explorar cultura"
      buttonLink2="/nica-page/culture"
    />
  </main>
  <Footer />
</Layout>
