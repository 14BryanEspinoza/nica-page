---
import Layout from "@layouts/Layout.astro";
import HeroSecondary from "@layouts/HeroSecondary.astro";
import CallToAction from "@layouts/CallToAction.astro";
import Footer from "@layouts/Footer.astro";
---

<Layout title="Nica-Page">
  <main id="main-content">
    <HeroSecondary
      id="historyPage"
      title="History of Nicaragua"
      description="A journey through the moments that defined our nation, plus fascinating facts."
    />
    <CallToAction
      title="Want to know more?"
      description="Discover the culture, festivities, and adventures that await you in Nicaragua."
      buttonText="Explore nature"
      buttonLink="/nica-page/nature"
      buttonText2="Explore culture"
      buttonLink2="/nica-page/culture"
    />
  </main>
  <Footer />
</Layout>
