---
import Layout from "@layouts/Layout.astro";
import HeroSecondary from "@layouts/HeroSecondary.astro";
import CallToAction from "@layouts/CallToAction.astro";
import Footer from "@layouts/Footer.astro";
---

<Layout title="Nica-Page">
  <main id="main-content">
    <HeroSecondary
      id="gastronomyPage"
      title="Nicaraguan Cuisine"
      description="A fusion of Indigenous, Spanish, and Afro-Caribbean flavors."
    />
    <CallToAction
      title="Ready to try our food?"
      description="Nicaragua offers a unique culinary experience. Learn more about our tourist destinations and plan your trip."
      buttonText="Explore tourism"
      buttonLink="/nica-page/tourism"
      buttonText2="Explore history"
      buttonLink2="/nica-page/history"
    />
  </main>
  <Footer />
</Layout>
