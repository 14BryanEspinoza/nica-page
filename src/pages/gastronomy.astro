---
import Layout from "@layouts/Layout.astro";
import HeroSecondary from "@layouts/HeroSecondary.astro";
import Meals from "@layouts/Meals.astro";
import CallToAction from "@layouts/CallToAction.astro";
import Footer from "@layouts/Footer.astro";
---

<Layout title="NicaPage | Gastronomía">
  <main id="main-content">
    <HeroSecondary
      id="gastronomyPage"
      title="Gastronomía nicaragüense"
      description="Una fusión de sabores indígenas, españoles y afrocaribeños."
    />
    <Meals />
    <CallToAction
      title="¿Listo para probar nuestra comida?"
      description="Nicaragua ofrece una experiencia culinaria única. Conoce más sobre nuestros destinos turísticos y planifica tu viaje."
      buttonText="Explorar turismo"
      buttonLink="/nica-page/tourism"
      buttonText2="Explorar historia"
      buttonLink2="/nica-page/history"
    />
  </main>
  <Footer />
</Layout>
