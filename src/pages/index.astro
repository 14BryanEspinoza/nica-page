---
import { getCollection } from "astro:content";

import Layout from "@layouts/Layout.astro";
import Hero from "@layouts/Hero.astro";
import Discover from "@layouts/Discover.astro";
import Featured from "@layouts/Featured.astro";
import CallToAction from "@layouts/CallToAction.astro";
import Footer from "@layouts/Footer.astro";

const destination = await getCollection("destination");
const gastronomy = await getCollection("gastronomy");

const destShort = destination.slice(3, 6);
const gastShort = gastronomy.slice(2, 5);
---

<Layout
  description="Descubre Nicaragua con NicaPage: destinos destacados, sabores de su gastronomía y un video para inspirar tu viaje por la tierra de los lagos y los volcanes."
  keywords="Nicaragua, guía de viaje, destinos, gastronomía, historia, cultura, naturaleza"
>
  <main id="main-content">
    <Hero />
    <Discover />
    <Featured
      title="Destinos destacados"
      description="Desde playas de arena blanca hasta volcanes activos, Nicaragua ofrece experiencias únicas para cada tipo de viajero..."
      collection={destShort}
      link={import.meta.env.BASE_URL + "tourism"}
      label="Destinos"
    />
    <Featured
      title="Sabores de Nicaragua"
      description="La gastronomía nicaragüense es una fusión de influencias indígenas, españolas y africanas que crea sabores únicos e inolvidables..."
      collection={gastShort}
      link={import.meta.env.BASE_URL + "gastronomy"}
      label="Gastronomía"
    />
    <CallToAction
      title="¿Listo para descubrir Nicaragua?"
      description="Explora nuestra completa guía de viaje, descubre la historia de nuestra tierra y maravíllate con los fascinantes detalles de este país único."
      buttonText="Explorar historia"
      buttonLink={import.meta.env.BASE_URL + "history"}
      buttonText2="Explorar cultura"
      buttonLink2={import.meta.env.BASE_URL + "culture"}
    />
  </main>
  <Footer />
</Layout>
