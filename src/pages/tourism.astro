---
import Layout from "@layouts/Layout.astro";
import HeroSecondary from "@layouts/HeroSecondary.astro";
import Cities from "@layouts/Cities.astro";
import CallToAction from "@layouts/CallToAction.astro";
import Footer from "@layouts/Footer.astro";
---

<Layout
  title="NicaPage - Turismo"
  description="Recorre los destinos de Nicaragua: playas del Pacífico y el Caribe, ciudades coloniales como Granada y León, la isla de Ometepe y rutas culturales por el país."
  keywords="turismo Nicaragua, destinos, playas, ciudades coloniales, Ometepe, Granada, León, volcanes"
>
  <main id="main-content">
    <HeroSecondary
      title="Turismo en Nicaragua"
      description="Descubre los destinos más hermosos de la tierra de los lagos y los volcanes."
    />
    <Cities />
    <CallToAction
      title="¿Listo para tu aventura?"
      description="Descubre más sobre la gastronomía, la historia y los datos de interés de Nicaragua en nuestras otras secciones."
      buttonText="Explorar gastronomía"
      buttonLink={import.meta.env.BASE_URL + "gastronomy"}
      buttonText2="Explorar naturaleza"
      buttonLink2={import.meta.env.BASE_URL + "nature"}
    />
  </main>
  <Footer />
</Layout>
