---
import Layout from "@layouts/Layout.astro";
import HeroSecondary from "@layouts/HeroSecondary.astro";
import CallToAction from "@layouts/CallToAction.astro";
import Footer from "@layouts/Footer.astro";
---

<Layout title="Nica-Page">
  <main id="main-content">
    <HeroSecondary
      id="tourismPage"
      title="Tourism in Nicaragua"
      description="Discover the most beautiful destinations in the land of lakes and volcanoes."
    />
    <CallToAction
      title="Ready for your adventure?"
      description="Discover more about the gastronomy, history, and interesting facts of Nicaragua in our other sections."
      buttonText="Explore gastronomy"
      buttonLink="/nica-page/gastronomy"
      buttonText2="Explore nature"
      buttonLink2="/nica-page/nature"
    />
  </main>
  <Footer />
</Layout>
