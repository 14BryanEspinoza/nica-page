---
import type { ImageMetadata } from "astro";
import Link from "@components/Link.astro";

interface Props {
  id: string;
  title: string;
  image: ImageMetadata;
  attractions: {
    name: string;
    url: string;
  }[];
  moreInfoUrl: string;
}

const { id, title, image, attractions, moreInfoUrl } = Astro.props;

const baseArticleStyle =
  "group overflow-hidden relative min-h-80 rounded-md bg-cover bg-center";
const beforeStyle =
  "before:content-[''] before:absolute before:inset-0 before:bg-linear-to-b before:from-transparent before:to-black/80 before:pointer-events-none";
const baseCardStyle =
  "relative z-10 flex flex-col justify-end gap-4 mx-6 pb-6 h-full text-bg-primary";
---

<article
  id={id}
  class=`${baseArticleStyle} ${beforeStyle}`
  style={`background-image: url('${image.src}')`}
>
  <div
    class=`${baseCardStyle} translate-y-60 transition-transform duration-300 ease-in-out group-hover:translate-y-0`
  >
    <h3 class="text-xl font-bold">{title}</h3>

    <ul>
      {attractions.map((attraction) => (
        <li>
          <Link
            url={attraction.url}
            label={attraction.name}
            targ
            className="mb-2 justify-start hover:underline"
          />
        </li>
      ))}
    </ul>

    <Link
      url={moreInfoUrl}
      label="Ver más"
      icon="lucide:plus"
      viewIcon
      targ
      className=" w-fit rounded-md bg-text-blue-light px-4 py-2 font-bold text-bg-primary hover:bg-text-success"
    />
  </div>
</article>
