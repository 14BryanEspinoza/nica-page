---
import { Icon } from "astro-icon/components";

interface Props {
  url: string;
  label?: string;
  skip?: boolean;
  icon?: string;
  className?: string;
  active?: boolean;
}

const { url, label, className, skip, icon, active } = Astro.props as Props;
const baseStyle =
  "flex gap-2 items-center justify-center transition hover:scale-105";
const skipStyle =
  "absolute top-0 left-4 z-50 -translate-y-12 px-6 py-2 rounded-md font-bold text-white bg-text-blue-light transition focus:translate-y-4";
const activeStyle =
  "font-bold text-text-blue-light border-b-2 border-text-blue-light";
---

<a
  href={url}
  class={`${skip ? skipStyle : baseStyle} ${className} ${active ? activeStyle : ""}`}
>
  {icon && <Icon name={icon} class="text-xl" />}
  {label}
</a>
