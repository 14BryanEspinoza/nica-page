---
import { Icon } from "astro-icon/components";

interface Props {
  url: string;
  label?: string;
  targ?: boolean;
  icon?: string;
  skip?: boolean;
  active?: boolean;
  className?: string;
}

const baseStyle =
  "flex gap-2 items-center justify-center text-sm transition hover:scale-105";
const skipStyle =
  "sr-only text-bg-primary transition focus:not-sr-only focus:absolute focus:top-3 focus:left-6 focus:z-50 focus:px-6 focus:py-2 focus:rounded-md focus:font-bold focus:bg-primary";
const activeStyle = "font-bold text-primary border-b-2 border-primary";

const { url, label, targ, icon, skip, active, className = "" } = Astro.props;
---

<a
  href={url}
  target={targ ? "_blank" : ""}
  rel={targ ? "noopener noreferrer" : ""}
  class={`${skip ? skipStyle : baseStyle} ${className} ${active ? activeStyle : ""}`}
>
  {icon && <Icon name={icon} class="text-lg" />}
  {label}
</a>
