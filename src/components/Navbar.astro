---
import { Icon } from "astro-icon/components";
import { linkNavbar } from "@data/links";
import Link from "@components/Link.astro";

const currentPath = Astro.url.pathname;
---

<a
  class="flex items-center gap-2 transition hover:scale-105"
  href={import.meta.env.BASE_URL}
>
  <figure class="size-7">
    <img
      src={import.meta.env.BASE_URL + "favicon.png"}
      alt="ir al inicio"
      loading={"eager"}
    />
  </figure>
  <span class="text-lg font-bold text-text-blue">NicaPage</span>
</a>

<button
  type="button"
  id="menu-toggle"
  class="lg:hidden"
  aria-expanded="false"
  aria-controls="nav-main"
  aria-label="menú de navegación"
>
  <Icon name="lucide:menu" class="cursor-pointer text-3xl" aria-hidden="true" />
</button>

<nav
  id="nav-main"
  class="hidden h-[91dvh] w-full flex-col items-center justify-center lg:flex lg:h-auto lg:w-auto"
  aria-label="Navegación principal"
>
  <ul role="list" class="lg:flex lg:items-center lg:gap-6">
    {linkNavbar.map((link) => {
      const normalize = (path: string) => path.replace(/\/$/, "");
      const isActive = normalize(currentPath) === normalize(link.url);

      return (
        <li>
          <Link
            {...link}
            className="mt-12 w-fit hover:text-text-blue lg:mt-0"
            active={isActive}
          />
        </li>
      );
    })}
  </ul>
</nav>

<script>
  const btn = document.getElementById("menu-toggle");
  const nav = document.getElementById("nav-main");

  let open = false;

  const setOpen = (next: boolean) => {
    open = next;

    btn?.setAttribute("aria-expanded", String(open));

    nav?.classList.toggle("hidden", !open);
    nav?.classList.toggle("flex", open);
  };

  btn?.addEventListener("click", () => setOpen(!open));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && open) {
      setOpen(false);
      btn?.focus();
    }
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });
</script>
