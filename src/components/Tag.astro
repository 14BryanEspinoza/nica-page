---
import { Icon } from "astro-icon/components";

interface Props {
  label: string;
  icon: string;
  className?: string;
}

const { label, icon, className = "" } = Astro.props;
---

<span
  class=`inline-flex items-center gap-2 text-xs rounded-full border px-4 py-2 uppercase ${className}`
>
  <Icon name=`lucide:${icon}` class="size-4" />
  {label}
</span>
